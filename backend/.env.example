CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Supabase > Connect > Session pooler. Sustituye los valores de ejemplo.
# Codifica los caracteres especiales de la contraseña en formato URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Integraciones: completa estos valores únicamente en backend/.env.
# Token privado de https://apisperu.com/servicios/dniruc
APISPERU_TOKEN=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
# Geoapify: mapas en el navegador y búsqueda de direcciones desde FastAPI.
# La clave de mapas es visible en el navegador; configurar restricciones en Geoapify.
GEOAPIFY_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=8
SESSION_HOURS=12
# true solo al servir el backend por HTTPS; false en desarrollo local.
COOKIE_SECURE=false
