CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Supabase > Connect > Session pooler. Sustituye los valores de ejemplo.
# Codifica los caracteres especiales de la contraseña en formato URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
